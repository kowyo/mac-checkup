t() {
  if [[ $UI_LANG == zh && -n ${ZH[$1]} ]]; then
    print -rn -- "${ZH[$1]}"
  else
    print -rn -- "${EN[$1]}"
  fi
}

lookup() {
  local zh_ref="${1}_ZH[$2]" en_ref="${1}_EN[$2]"
  if [[ $UI_LANG == zh && -n ${(P)zh_ref} ]]; then
    print -rn -- "${(P)zh_ref}"
  elif [[ -n ${(P)en_ref} ]]; then
    print -rn -- "${(P)en_ref}"
  else
    print -rn -- "$2"
  fi
}

if [[ -t 1 && -z $NO_COLOR ]]; then
  C_GREEN=$'\e[32m' C_YELLOW=$'\e[33m' C_RED=$'\e[31m' C_DIM=$'\e[2m' C_BOLD=$'\e[1m' C_RESET=$'\e[0m'
else
  C_GREEN="" C_YELLOW="" C_RED="" C_DIM="" C_BOLD="" C_RESET=""
fi

heading() { print -r -- ""; print -r -- "${C_BOLD}$1${C_RESET}"; }

row() {
  local mark
  case $1 in
    ok) mark="${C_GREEN}✓${C_RESET}" ;;
    warn) mark="${C_YELLOW}!${C_RESET}" ;;
    bad) mark="${C_RED}✗${C_RESET}" ;;
    *) mark="${C_DIM}·${C_RESET}" ;;
  esac
  if [[ -n $3 ]]; then
    print -r -- "  $mark $2: $3"
  else
    print -r -- "  $mark $2"
  fi
}

note() { print -r -- "    ${C_DIM}$1${C_RESET}"; }

field() {
  print -r -- "$1" | awk -v key="$2" '
    { line = $0; sub(/^[ \t]+/, "", line) }
    index(line, key ": ") == 1 { print substr(line, length(key) + 3); exit }
  '
}

ioreg_platform_string() {
  local raw
  raw=$(ioreg -rd1 -c IOPlatformExpertDevice | awk -v key="\"$1\"" '$1 == key { sub(/^[^=]*= /, ""); print; exit }')
  raw=${raw#<}
  raw=${raw%>}
  if [[ $raw == \"*\" ]]; then
    print -rn -- "${raw//\"/}"
  elif [[ -n $raw ]]; then
    print -rn -- "$raw" | xxd -r -p | tr -d '\0'
  fi
}

mask_serial() {
  local serial=$1
  if (( SHOW_SERIAL )) || (( ${#serial} < 8 )); then
    print -rn -- "$serial"
  else
    print -rn -- "${serial[1,4]}••••${serial[-2,-1]}"
  fi
}

read_repair_history() {
  /usr/bin/log show --last "$1" --style compact \
    --predicate 'subsystem == "com.apple.corerepair" AND eventMessage CONTAINS "repairHistoryForUI"' 2>/dev/null |
    awk '
      /repairHistoryForUI:\{/ { buffer = ""; capturing = 1; next }
      capturing && /^\}/ { capturing = 0; latest = buffer; next }
      capturing { buffer = buffer $0 "\n" }
      END { printf "%s", latest }
    '
}

refresh_repair_history() {
  local settings_was_running=0 attempt history
  pgrep -xq "System Settings" && settings_was_running=1
  open -g "$ABOUT_PANE_URL" 2>/dev/null || return 1
  for attempt in {1..10}; do
    sleep 2
    history=$(read_repair_history 2m)
    [[ -n $history ]] && break
  done
  (( settings_was_running )) || osascript -e 'tell application "System Settings" to quit' >/dev/null 2>&1
  print -rn -- "$history"
}

normalize_language() {
  local tag=$1
  case $tag in
    zh-Hans*|zh-CN|zh-SG) print -rn -- "zh-CN" ;;
    zh-Hant-HK|zh-Hant-MO|zh-HK|zh-MO|yue*) print -rn -- "zh-HK" ;;
    nb*|no*) print -rn -- "nb" ;;
    zh-Hant*|zh-TW) print -rn -- "zh-TW" ;;
    *) print -rn -- "${tag%%[-_]*}" ;;
  esac
}

language_supported() {
  case $(normalize_language "$1") in
    en|da|nl|fr|de|it|nb|pt|es|sv|tr|vi|zh-CN|zh-TW|zh-HK|ja|ko) return 0 ;;
    *) return 1 ;;
  esac
}

while (( $# )); do
  case $1 in
    --show-serial) SHOW_SERIAL=1 ;;
    --no-open) ALLOW_OPEN=0 ;;
    --lang) shift; UI_LANG=$1 ;;
    --lang=*) UI_LANG=${1#--lang=} ;;
    --version) print -r -- "mac-checkup $VERSION"; exit 0 ;;
    -h|--help) SHOW_HELP=1 ;;
    *) print -u2 -r -- "mac-checkup: unknown option $1"; exit 2 ;;
  esac
  shift
done

if [[ $(uname -s) != Darwin ]]; then
  print -u2 -r -- "mac-checkup only runs on macOS."
  exit 1
fi

primary_language=$(defaults read -g AppleLanguages 2>/dev/null | sed -n '2p' | tr -d ' ",')
if [[ -z $UI_LANG ]]; then
  [[ $primary_language == zh* ]] && UI_LANG=zh || UI_LANG=en
fi

if (( SHOW_HELP )); then
  t usage
  print
  exit 0
fi

hardware_info=$(system_profiler SPHardwareDataType 2>/dev/null)
power_info=$(system_profiler SPPowerDataType 2>/dev/null)
storage_info=$(system_profiler SPNVMeDataType 2>/dev/null)
[[ -z $storage_info ]] && storage_info=$(system_profiler SPSerialATADataType 2>/dev/null)
keyboard_info=$(system_profiler SPSPIDataType 2>/dev/null)
display_info=$(system_profiler SPDisplaysDataType 2>/dev/null)

model_name=$(field "$hardware_info" "Model Name")
model_identifier=$(field "$hardware_info" "Model Identifier")
chip=$(field "$hardware_info" "Chip")
[[ -z $chip ]] && chip=$(field "$hardware_info" "Processor Name")
memory=$(field "$hardware_info" "Memory")
serial=$(field "$hardware_info" "Serial Number (system)")
macos_version=$(sw_vers -productVersion)
macos_build=$(sw_vers -buildVersion)
is_apple_silicon=$(sysctl -n hw.optional.arm64 2>/dev/null || print 0)
region_code=$(ioreg_platform_string region-info)
model_base=$(ioreg_platform_string model-number)
model_number=$(field "$hardware_info" "Model Number")
[[ -z $model_number && -n $model_base ]] && model_number="$model_base$region_code"

print -r -- "${C_BOLD}$(t title)${C_RESET} ${C_DIM}v$VERSION${C_RESET}"

heading "$(t sec_device)"
row info "$(t model)" "$model_name ($model_identifier)"
row info "$(t model_number)" "${model_number:-$(t unknown)}"
if [[ -n $region_code ]]; then
  row info "$(t sold_in)" "$(lookup REGION "$region_code") ($region_code)"
else
  row info "$(t sold_in)" "$(t unknown)"
fi
row info "$(t chip)" "$chip"
row info "$(t memory)" "$memory"
row info "$(t serial)" "$(mask_serial "$serial")"
row info "$(t macos)" "$macos_version ($macos_build)"

heading "$(t sec_repair)"
parts_verdict=unknown
if [[ $is_apple_silicon == 1 ]] && is-at-least 26 "$macos_version"; then
  repair_history=$(read_repair_history 30d)
  if [[ -z $repair_history ]] && (( ALLOW_OPEN )); then
    note "$(t repair_refreshing)"
    repair_history=$(refresh_repair_history)
  fi
  if [[ -z $repair_history ]]; then
    row warn "$(t sec_repair)" "$(t repair_missing)"
  else
    parts_verdict=ok
    for history_line in ${(f)repair_history}; do
      component=$(print -r -- "$history_line" | sed -nE 's/.*componentName:([^:]+):.*/\1/p')
      [[ -z $component ]] && continue
      is_repaired=$(print -r -- "$history_line" | sed -nE 's/.*isRepaired:([0-9]+):.*/\1/p')
      is_used=$(print -r -- "$history_line" | sed -nE 's/.*isUsed:([0-9]+):.*/\1/p')
      repair_date=$(print -r -- "$history_line" | sed -nE 's/.*repairDate:(.*):\].*/\1/p')
      component_label=$(lookup COMPONENT "$component")
      if [[ $is_used == 1 ]]; then
        row bad "$component_label" "$(t repair_used)"
        parts_verdict=bad
      elif [[ $is_repaired == 1 ]]; then
        if [[ -n $repair_date && $repair_date != "(null)" ]]; then
          row warn "$component_label" "$(printf "$(t repair_repaired)" "${repair_date%% *}")"
        else
          row warn "$component_label" "$(t repair_repaired_nodate)"
        fi
        parts_verdict=bad
      else
        row ok "$component_label" "$(t repair_original)"
      fi
    done
    [[ $parts_verdict == bad ]] && note "$(t repair_hint_settings)"
  fi
else
  note "$(t repair_unsupported)"
fi

heading "$(t sec_parts)"
cycle_count=$(field "$power_info" "Cycle Count")
if [[ -n $cycle_count ]]; then
  battery_condition=$(field "$power_info" "Condition")
  battery_capacity=$(field "$power_info" "Maximum Capacity")
  battery_status=ok
  [[ $battery_condition != Normal ]] && battery_status=warn
  row $battery_status "$(t battery)" "$(printf "$(t battery_detail)" "$cycle_count" "${battery_capacity:-?}" "${battery_condition:-?}")"
  note "$(t battery_note)"
else
  row info "$(t battery)" "$(t battery_none)"
fi

storage_model=$(field "$storage_info" "Model")
if [[ -n $storage_model ]]; then
  smart_status=$(field "$storage_info" "S.M.A.R.T. status")
  storage_status=ok
  [[ $storage_model != APPLE* || $smart_status != Verified ]] && storage_status=warn
  storage_text=$(printf "$(t storage_detail)" "$storage_model" "${smart_status:-?}")
  [[ $(field "$storage_info" "Detachable Drive") == No && $is_apple_silicon == 1 ]] && storage_text="$storage_text$(t list_sep)$(t storage_soldered)"
  row $storage_status "$(t storage)" "$storage_text"
fi

keyboard_vendor=$(print -r -- "$keyboard_info" | awk '/Internal Keyboard/ { found = 1 } found && /Manufacturer:/ { sub(/^[^:]*: /, ""); print; exit }')
if [[ -n $keyboard_vendor ]]; then
  keyboard_status=ok
  [[ $keyboard_vendor != Apple* ]] && keyboard_status=warn
  row $keyboard_status "$(t keyboard)" "$(printf "$(t keyboard_detail)" "$keyboard_vendor")"
fi

builtin_display=$(field "$display_info" "Display Type")
[[ -n $builtin_display ]] && row info "$(t display)" "$builtin_display"

touch_id_status=$(bioutil -rs 2>/dev/null)
if [[ $touch_id_status == *"Biometrics functionality: 1"* ]]; then
  if [[ $touch_id_status == *"Biometrics for unlock: 1"* ]]; then
    row ok "$(t touchid)" "$(t touchid_working)"
  else
    row info "$(t touchid)" "$(t touchid_off)"
  fi
fi

heading "$(t sec_security)"
security_blocked=0

activation_lock=$(field "$hardware_info" "Activation Lock Status")
case $activation_lock in
  Disabled) row ok "$(t activation_lock)" "$(t activation_lock_off)" ;;
  Enabled) row warn "$(t activation_lock)" "$(t activation_lock_on)" ;;
esac

enrollment_status=$(profiles status -type enrollment 2>/dev/null)
if [[ $enrollment_status == *"Enrolled via DEP: Yes"* ]]; then
  row bad "$(t mdm)" "$(t mdm_dep)"
  security_blocked=1
elif [[ $enrollment_status == *"MDM enrollment: Yes"* ]]; then
  row bad "$(t mdm)" "$(t mdm_enrolled)"
  security_blocked=1
elif [[ -n $enrollment_status ]]; then
  row ok "$(t mdm)" "$(t mdm_none)"
fi
if grep -qiE '^[^#]*(deviceenrollment|mdmenrollment|iprofiles|acmdm)\.apple\.com' /etc/hosts 2>/dev/null; then
  row bad "$(t mdm)" "$(t mdm_bypass)"
  security_blocked=1
fi

installed_profiles=$(system_profiler SPConfigurationProfileDataType 2>/dev/null | awk '
  function flush() { if (name != "") print scope "|" name "|" source; name = ""; source = "" }
  /^    User .*Configuration Profiles:$/ { flush(); scope = "user"; next }
  /^    Device Configuration Profiles:$/ { flush(); scope = "device"; next }
  scope != "" && /^        [^ ].*:$/ { flush(); name = $0; sub(/^ +/, "", name); sub(/:$/, "", name); next }
  name != "" && /^          Source: / { source = $0; sub(/^ *Source: /, "", source) }
  END { flush() }
')
if [[ -z $installed_profiles ]]; then
  row ok "$(t profiles)" "$(t profiles_none)"
else
  has_device_profile=0
  for profile_line in ${(f)installed_profiles}; do
    profile_scope=${profile_line%%|*}
    profile_rest=${profile_line#*|}
    profile_name=${profile_rest%%|*}
    profile_source=${profile_rest#*|}
    profile_text="$profile_name"
    [[ -n $profile_source ]] && profile_text="$profile_text ($profile_source)"
    if [[ $profile_scope == device ]]; then
      row warn "$(t profiles) · $(t profiles_device)" "$profile_text"
      has_device_profile=1
    else
      row info "$(t profiles) · $(t profiles_user)" "$profile_text"
    fi
  done
  (( has_device_profile )) && note "$(t profiles_note)"
fi

if [[ -n $(print -l ~/Library/Application\ Support/iCloud/Accounts/<->(N)) ]] || defaults read MobileMeAccounts Accounts 2>/dev/null | grep -q AccountID; then
  row info "$(t apple_account)" "$(t apple_account_in)"
else
  row info "$(t apple_account)" "$(t apple_account_out)"
fi

if [[ $(fdesetup status 2>/dev/null) == *"FileVault is On"* ]]; then
  row ok "$(t filevault)" "$(t filevault_on)"
else
  row warn "$(t filevault)" "$(t filevault_off)"
fi

if [[ $(csrutil status 2>/dev/null) == *"enabled."* ]]; then
  row ok "$(t sip)" "$(t sip_on)"
else
  row warn "$(t sip)" "$(t sip_off)"
fi

heading "$(t sec_ai)"
ai_blocked=0
ai_warnings=0
region_label="$(lookup REGION "$region_code") ($region_code)"
siri_language=$(defaults read com.apple.assistant.backedup "Session Language" 2>/dev/null)
storefront_id=$(defaults read com.apple.itunesstored AccountsNotificationPlugin.ActiveStorefrontIdentifier 2>/dev/null)
storefront_id=${storefront_id%%-*}
eligibility_file=/private/var/db/eligibilityd/eligibility.plist
ai_domain=OS_ELIGIBILITY_DOMAIN_GREYMATTER
ai_answer=$(plutil -extract "$ai_domain.os_eligibility_answer_t" raw -o - "$eligibility_file" 2>/dev/null)

if [[ -n $ai_answer ]]; then
  typeset -A ai_inputs
  ai_inputs=($(plutil -extract "$ai_domain.status" json -o - "$eligibility_file" 2>/dev/null |
    tr ',{}' '\n\n\n' | sed -nE 's/^"OS_ELIGIBILITY_INPUT_([A-Z_]+)":([0-9]+)$/\1 \2/p'))
  if [[ $ai_answer == 4 ]]; then
    row ok "$(t ai_system)" "$(t ai_system_yes)"
  else
    row bad "$(t ai_system)" "$(t ai_system_no)"
    ai_blocked=1
  fi
  typeset -U ai_input_order
  ai_input_order=(DEVICE_CLASS GENERATIVE_MODEL_SYSTEM DEVICE_REGION_CODE COUNTRY_LOCATION COUNTRY_BILLING
    DEVICE_LANGUAGE SIRI_LANGUAGE DEVICE_AND_SIRI_LANGUAGE_MATCH EXTERNAL_BOOT_DRIVE SHARED_IPAD ${(ko)ai_inputs})
  for ai_input in $ai_input_order; do
    input_value=${ai_inputs[$ai_input]}
    [[ -z $input_value ]] && continue
    input_label=$(lookup AIINPUT "$ai_input")
    case $ai_input in
      DEVICE_REGION_CODE) input_detail=$region_label ;;
      COUNTRY_BILLING) input_detail=$([[ -n $storefront_id ]] && lookup STOREFRONT "$storefront_id") ;;
      DEVICE_LANGUAGE) input_detail=$primary_language ;;
      SIRI_LANGUAGE) input_detail=$siri_language ;;
      DEVICE_CLASS) input_detail=$model_identifier ;;
      *) input_detail="" ;;
    esac
    case $input_value in
      3) row ok "$input_label" "${input_detail:-$(t ai_pass)}" ;;
      2)
        case $ai_input in
          DEVICE_REGION_CODE) [[ $region_code == CH/A ]] && input_detail=$(printf "$(t ai_device_region_cn)" "$region_label") ;;
          COUNTRY_LOCATION) input_detail=$(t ai_location_fail) ;;
          DEVICE_AND_SIRI_LANGUAGE_MATCH) input_detail=$(printf "$(t ai_match_fail)" "$primary_language" "${siri_language:-?}") ;;
        esac
        row bad "$input_label" "${input_detail:-$(t ai_fail)}"
        ;;
      *) row info "$input_label" "$(printf "$(t ai_input_unknown)" "$input_value")" ;;
    esac
  done
else
  note "$(t ai_estimated)"
  if [[ $is_apple_silicon == 1 ]]; then
    row ok "$(t ai_chip)" "$(t ai_chip_ok)"
  else
    row bad "$(t ai_chip)" "$(t ai_chip_bad)"
    ai_blocked=1
  fi

  if is-at-least 15.1 "$macos_version"; then
    row ok "$(t ai_os)" "$macos_version"
  else
    row bad "$(t ai_os)" "$(printf "$(t ai_os_bad)" "$macos_version")"
    ai_blocked=1
  fi

  if [[ $region_code == CH/A ]]; then
    row bad "$(t ai_device_region)" "$(printf "$(t ai_device_region_cn)" "$region_label")"
    ai_blocked=1
  elif [[ -n $region_code ]]; then
    row ok "$(t ai_device_region)" "$region_label"
  else
    row warn "$(t ai_device_region)" "$(t unknown)"
  fi

  if [[ -z $storefront_id ]]; then
    row info "$(t ai_account)" "$(t ai_account_none)"
  elif [[ $storefront_id == 143465 && $region_code != CH/A ]]; then
    row warn "$(t ai_account)" "$(printf "$(t ai_account_cn)" "$(lookup STOREFRONT 143465)")"
    ai_warnings=1
  else
    row info "$(t ai_account)" "$(lookup STOREFRONT "$storefront_id")"
  fi

  if language_supported "$primary_language"; then
    row ok "$(t ai_lang_sys)" "$primary_language"
  else
    row warn "$(t ai_lang_sys)" "$(printf "$(t ai_lang_unsupported)" "$primary_language")"
    ai_warnings=1
  fi
  if [[ -z $siri_language ]]; then
    row info "$(t ai_lang_siri)" "$(t ai_lang_unset)"
  elif ! language_supported "$siri_language"; then
    row warn "$(t ai_lang_siri)" "$(printf "$(t ai_lang_unsupported)" "$siri_language")"
    ai_warnings=1
  elif [[ $(normalize_language "$siri_language") != $(normalize_language "$primary_language") ]]; then
    row warn "$(t ai_lang_siri)" "$siri_language"
    note "$(t ai_lang_mismatch)"
    ai_warnings=1
  else
    row ok "$(t ai_lang_siri)" "$siri_language"
  fi
fi

free_gb=$(( $(df -k / | awk 'NR == 2 { print $4 }') / 1024 / 1024 ))
if (( free_gb >= AI_MIN_FREE_GB )); then
  row ok "$(t ai_disk)" "$(printf "$(t ai_disk_ok)" "$free_gb")"
else
  row warn "$(t ai_disk)" "$(printf "$(t ai_disk_bad)" "$free_gb" "$AI_MIN_FREE_GB")"
  ai_warnings=1
fi

heading "$(t sec_summary)"
case $parts_verdict in
  ok) row ok "$(t verdict_parts_ok)" ;;
  bad) row bad "$(t verdict_parts_bad)" ;;
  *) row warn "$(t verdict_parts_unknown)" ;;
esac
if (( security_blocked )); then
  row bad "$(t verdict_security_bad)"
else
  row ok "$(t verdict_security_ok)"
fi
if (( ai_blocked )); then
  row bad "$(t verdict_ai_no)"
elif (( ai_warnings )); then
  row warn "$(t verdict_ai_maybe)"
else
  row ok "$(t verdict_ai_yes)"
fi
note "$(t verdict_store)"
